// CakeText Translator's display settings on CakeUI's config hub (CakeUI ADR 0011). Shipped in its jar.
// Engine, keys and models stay in its own settings screen (/cttranslate).
{
  format: 1, mod: ["caketext-translator", "caketext_translator"], versions: "*", file: "config/caketext/translator.json", type: "json",
  title: "caketext_translator.title",
  options: [
    { key: "enabled", type: "bool", label: "caketext_translator.option.enabled", default: true },
    { key: "display", type: "enum", label: "caketext_translator.option.display", default: "TRANSLATED", values: [ { value: "TRANSLATED", label: "caketext_translator.display.translated" }, { value: "BOTH", label: "caketext_translator.display.both" }, { value: "ORIGINAL", label: "caketext_translator.display.original" } ] },
    { key: "chatDisplay", type: "enum", label: "caketext_translator.option.chat_display", default: "ORIGINAL", values: [ { value: "TRANSLATED", label: "caketext_translator.display.translated" }, { value: "BOTH", label: "caketext_translator.display.both" }, { value: "ORIGINAL", label: "caketext_translator.display.original" } ] },
    { key: "playerChat", type: "bool", label: "caketext_translator.option.player_chat", default: true },
    { key: "playerChatDisplay", type: "enum", label: "caketext_translator.option.player_chat_display", default: "ORIGINAL", values: [ { value: "TRANSLATED", label: "caketext_translator.display.translated" }, { value: "BOTH", label: "caketext_translator.display.both" }, { value: "ORIGINAL", label: "caketext_translator.display.original" } ] },
    { key: "translateItemNames", type: "bool", label: "caketext_translator.option.item_names", default: false },
    { key: "tooltipAlt", type: "enum", label: "caketext_translator.option.tooltip_alt", default: "ORIGINAL_ON_ALT", values: [ { value: "ORIGINAL_ON_ALT", label: "caketext_translator.tooltip_alt.original_on_alt" }, { value: "TRANSLATION_ON_ALT", label: "caketext_translator.tooltip_alt.translation_on_alt" }, { value: "OFF", label: "caketext_translator.tooltip_alt.off" } ] },
    { key: "tooltipFooter", type: "bool", label: "caketext_translator.option.tooltip_footer", default: true },
    { key: "markers", type: "enum", label: "caketext_translator.option.markers", default: "ALL", values: [ { value: "ALL", label: "caketext_translator.markers.all" }, { value: "MACHINE", label: "caketext_translator.markers.machine" }, { value: "OFF", label: "caketext_translator.markers.off" } ] },
  ],
}
