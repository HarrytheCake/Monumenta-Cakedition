{
	"schemaVersion": 1,
	"id": "caketext-translator",
	"version": "${version}",
	"name": "CakeText Translator",
	"description": "Translates server text (chat, scoreboard, tooltips, titles, boss bars, nameplates) from string files, and with a local opus-mt model for strings that aren't translated yet. An icon shows where each translation came from.",
	"authors": ["HarrytheCake"],
	"license": "Apache-2.0",
	"contact": {
		"sources": "https://github.com/HarrytheCake/CakeText"
	},
	"icon": "assets/caketext_translator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.harrythecake.caketext.translator.TranslatorMod"],
		"modmenu": ["io.github.harrythecake.caketext.translator.ui.ModMenuEntry"]
	},
	"mixins": ["caketext-translator.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"caketext-core": "*"
	}
}
