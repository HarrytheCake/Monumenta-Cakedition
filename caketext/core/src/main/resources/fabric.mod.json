{
	"schemaVersion": 1,
	"id": "caketext-core",
	"version": "${version}",
	"name": "CakeText Core",
	"description": "Shared code for CakeText Collector and CakeText Translator: text templates, strings files, game context and modules.",
	"authors": ["HarrytheCake"],
	"contact": {
		"sources": "https://github.com/HarrytheCake/CakeText"
	},
	"environment": "client",
	"entrypoints": {
		"caketext": ["io.github.harrythecake.caketext.core.module.UmmModule"]
	},
	"custom": {
		"modmenu": {
			"badges": ["library"],
			"parent": "caketext-translator"
		}
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*"
	}
}
