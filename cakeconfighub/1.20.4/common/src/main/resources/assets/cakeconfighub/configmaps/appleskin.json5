    {
      "key": "maxHudOverlayFlashAlpha",
      "type": "float",
      "label": "text.autoconfig.appleskin.option.maxHudOverlayFlashAlpha",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "step": 0.05
