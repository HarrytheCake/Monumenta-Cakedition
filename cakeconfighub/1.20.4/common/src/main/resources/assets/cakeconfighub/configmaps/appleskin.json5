    {
      "key": "showFoodValuesInTooltipAlways",
      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showFoodValuesInTooltipAlways",
      "default": true
    },
    {
      "key": "showSaturationHudOverlay",
      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showSaturationHudOverlay",
      "default": true
    },
    {
      "key": "showFoodValuesHudOverlay",
      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showFoodValuesHudOverlay",
      "default": true
    },
    {
      "key": "showFoodValuesHudOverlayWhenOffhand",
      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showFoodValuesHudOverlayWhenOffhand",
      "default": true
