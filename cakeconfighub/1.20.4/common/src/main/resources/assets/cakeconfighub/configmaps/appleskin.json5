      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showFoodDebugInfo",
      "default": true
    },
    {
      "key": "showVanillaAnimationsOverlay",
      "type": "bool",
      "label": "text.autoconfig.appleskin.option.showVanillaAnimationsOverlay",
      "default": true
