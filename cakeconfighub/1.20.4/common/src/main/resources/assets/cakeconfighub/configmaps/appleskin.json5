// CakeConfighub's config map for AppleSkin, checked against appleskin-fabric-mc1.20.3-2.5.1. Only in CakeConfighub's 1.20.4 jars.
{
  "format": 1,
  "mod": "appleskin",
  "versions": ">=2.5 <2.6",
  "file": "config/appleskin.json5",
  "type": "json5",
  "title": "AppleSkin",
  "options": [
    {
      "key": "showFoodValuesInTooltip",
      "type": "bool",
