// CakeConfighub's config map for Minecraft's options.txt (UI options), checked against Minecraft 1.20.4. Only in CakeConfighub's 1.20.4 jars.
// The game reads options.txt only at start: changes apply after a restart (vanilla's own Options screen applies at once).
{
  "format": 1,
  "mod": "minecraft",
  "versions": ">=1.20.4 <1.20.5",
  "file": "options.txt",
  "type": "options",
  "title": "Minecraft",
  "reload": "restart",
  "sections": [
    {
      "title": "options.chat.title",
      "options": [
        {
          "key": "chatOpacity",
          "type": "float",
          "label": "options.chat.opacity",
          "default": 1.0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "textBackgroundOpacity",
          "type": "float",
          "label": "options.accessibility.text_background_opacity",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "chatScale",
          "type": "float",
          "label": "options.chat.scale",
          "default": 1.0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "chatWidth",
          "type": "float",
          "label": "options.chat.width",
          "default": 1.0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "chatHeightFocused",
          "type": "float",
          "label": "options.chat.height.focused",
          "default": 1.0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "chatHeightUnfocused",
          "type": "float",
          "label": "options.chat.height.unfocused",
          "default": 0.44366195797920227,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "chatLineSpacing",
          "type": "float",
          "label": "options.chat.line_spacing",
          "default": 0.0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "backgroundForChatOnly",
          "type": "enum",
          "label": "options.accessibility.text_background",
          "default": true,
          "values": [
            {
              "value": true,
              "label": "options.accessibility.text_background.chat"
            },
            {
              "value": false,
              "label": "options.accessibility.text_background.everywhere"
            }
          ]
        },
        {
          "key": "chatColors",
          "type": "bool",
          "label": "options.chat.color",
          "default": true
        },
        {
          "key": "chatLinks",
          "type": "bool",
          "label": "options.chat.links",
          "default": true
        },
        {
          "key": "chatLinksPrompt",
          "type": "bool",
          "label": "options.chat.links.prompt",
          "default": true
        },
        {
          "key": "autoSuggestions",
          "type": "bool",
          "label": "options.autoSuggestCommands",
          "default": true
        },
        {
          "key": "hideMatchedNames",
          "type": "bool",
          "label": "options.hideMatchedNames",
          "default": true
        }
      ]
    },
    {
      "title": "",
      "options": [
        {
          "key": "guiScale",
          "type": "int",
          "label": "options.guiScale",
          "default": 0,
          "min": 0,
          "max": 6
        },
        {
