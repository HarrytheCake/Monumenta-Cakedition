{
	"schemaVersion": 1,
	"id": "cakechat",
	"version": "${version}",
	"name": "CakeChat",
	"description": "Chat windows and tabs with your own rules, unlimited history that survives server switches, compacted duplicate messages, regex search and timestamps. Can import your ChatPlus setup.",
	"authors": ["HarrytheCake"],
	"license": "MIT",
	"icon": "assets/cakechat/icon.png",
	"contact": {
		"sources": "https://github.com/HarrytheCake/CakeChat"
	},
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.harrythecake.cakechat.CakeChat"],
		"modmenu": ["io.github.harrythecake.cakechat.ModMenuEntry"]
	},
	"mixins": ["cakechat.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.6.0"
	},
	"conflicts": {
		"chatplus": "*"
	}
}
