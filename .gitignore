# Only the packwiz pack, its tooling and the updater mod source are tracked.
# Everything else (instance.cfg, .minecraft/, saves, jars, CLAUDE.md...) stays local.
/*
!/.gitignore
!/.gitattributes
!/pack/
!/tools/
!/updater/
!/caketext/
!/.github/
!/GLOSSARY-MAP.md
!/docs/
__pycache__/
updater/.gradle/
updater/build/
updater/run/
updater/bin/
updater/.vscode/
updater/.settings/
updater/.project
updater/.classpath
tools/bench/work/
tools/bench/mod/.gradle/
tools/bench/mod/build/
tools/bench/mod/run/
tools/bench/mod/bin/
