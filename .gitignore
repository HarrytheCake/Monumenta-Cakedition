# Only the packwiz pack, its tooling and our mods' sources are tracked.
# Everything else (instance.cfg, .minecraft/, saves, jars, CLAUDE.md...) stays local.
/*
!/.gitignore
!/.gitattributes
!/pack/
!/tools/
!/updater/
!/caketext/
!/cakewiki/
!/cakechat/
!/cakebook/
!/.github/
# docs/ and GLOSSARY-MAP.md (roadmap, glossary, ADRs, benchmark reports) stay local: never pushed (user's rule, 2026-10-28)
__pycache__/
updater/.gradle/
updater/build/
updater/run/
updater/bin/
updater/.vscode/
updater/.settings/
updater/.project
updater/.classpath
tools/bench/work/
tools/bench/mod/.gradle/
tools/bench/mod/build/
tools/bench/mod/run/
tools/bench/mod/bin/
