              "$ref": "#/definitions/number"
            },
            "elements": {
              "$ref": "#/definitions/elements"
            }
          },
          "description": "Inventory: the panel texture. Its elements are drawn in the panel's box (176×166 GUI pixels) and follow it."
        },
