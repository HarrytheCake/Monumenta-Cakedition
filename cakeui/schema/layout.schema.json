    },
    "$schema": {
      "type": "string"
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vanilla pieces this part changes (main_menu: background, logo, splash, version, buttons; game_launch: background, bar, logo; loading_screen: background, buttons; hud/subwindow_pause: background, buttons; hud/subwindow_inventory: background, panel, player, title, buttons).",
      "properties": {
        "background": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hide": {
              "$ref": "#/definitions/boolean",
              "description": "Hide vanilla's piece."
            },
            "x": {
              "$ref": "#/definitions/length"
            },
            "y": {
              "$ref": "#/definitions/length"
            },
            "scale": {
              "$ref": "#/definitions/number"
            },
            "opacity": {
              "$ref": "#/definitions/number"
            },
            "order": {
              "$ref": "#/definitions/number"
            },
            "elements": {
              "$ref": "#/definitions/elements"
            }
          }
        },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hide": {
              "$ref": "#/definitions/boolean",
              "description": "Hide vanilla's piece."
            },
            "x": {
              "$ref": "#/definitions/length"
            },
            "y": {
              "$ref": "#/definitions/length"
            },
            "scale": {
              "$ref": "#/definitions/number"
            },
            "opacity": {
              "$ref": "#/definitions/number"
            },
            "order": {
              "$ref": "#/definitions/number"
            },
            "elements": {
              "$ref": "#/definitions/elements"
            }
          }
        },
        "bar": {
