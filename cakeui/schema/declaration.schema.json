{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CakeUI declaration.json5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "constants": {
      "type": "object",
      "description": "Fixed values. \"= expression\" may use other constants only.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    },
    "variables": {
      "type": "object",
      "description": "A plain value is state this folder's buttons can set. \"= expression\" or text with {...} is computed every frame.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    }
  }
}
