{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CakeUI window.json5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "Layout format version."
    },
    "design": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[width, height] of the design screen; r units are its pixels."
    },
    "scale": {
      "enum": [
        "fit",
        "fill",
        "stretch"
      ],
      "description": "How the design screen fits the real one."
    },
    "perspective": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Camera distance for 3D, in design pixels (default 1000)."
    },
    "fonts": {
      "type": "object",
      "description": "Fonts from assets/, by name.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "description": "Path inside assets/, e.g. fonts/x.ttf"
              },
              "size": {
                "type": "number",
                "description": "Base size (default 11)."
              },
              "oversample": {
                "type": "number",
                "description": "Sharpness; 0 = automatic."
              },
              "shift": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        ]
      }
    },
    "icon": {
      "description": "Window icon: a PNG in assets/, or several sizes. Windows and Linux (X11); macOS keeps its icon.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "title": {
      "type": "string",
      "description": "Window title, with {expressions}; {window.title} is vanilla's title."
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "description": "Windows title bar. dark: Windows 10 2004+; colours: Windows 11. Other systems ignore it.",
      "properties": {
        "dark": {
          "description": "Dark title bar.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "color": {
          "type": "string",
          "description": "Title bar colour."
        },
        "text": {
          "type": "string",
          "description": "Title text colour."
        },
        "outline": {
          "type": "string",
          "description": "Window outline colour."
        }
      }
    }
  }
}
