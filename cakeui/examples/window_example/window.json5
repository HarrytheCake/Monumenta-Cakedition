// The CakeUI example layout. Copy this folder to <game>/cakeui/layouts/ and set
// layoutPath: "cakeui/layouts/window_example" in config/cakeui/config.json5.
{
  "$schema": "../../schema/window.schema.json",
  "format": 1,
  // Positions below are in pixels of a 1920×1080 screen ("r" units), scaled to the real one.
  "design": [1920, 1080],
  "scale": "fit",
  "perspective": 1400,
  // The game window. {window.title} is vanilla's title ("Minecraft* 1.20.4 - Multiplayer").
  "title": "Cakedition example · {window.title}",
  "icon": ["icon_16.png", "icon_32.png", "icon_48.png"],
  // Windows only: dark mode (Windows 10 2004+), colours (Windows 11).
  "border": { "dark": true, "color": "#1b1f2a", "text": "#f2f2ee", "outline": "#ffb000" },
}
