// Mojang's loading overlay, at start and on every resource reload (F3+T, changing resource packs).
// At the very first start Minecraft's own font isn't loaded yet: use images, rects and bars here,
// or text in a layout font (window.json5 fonts). {launch.progress} is 0…1; everything fades with
// vanilla's overlay.
{
  "$schema": "../../../schema/layout.schema.json",
  "ports": {
    "background": {
      "hide": true,
      "elements": {
        "sky": { "type": "image", "src": "bg.png", "width": "100%", "height": "100%", "fit": "cover" },
        "city": { "type": "image", "src": "far.png", "width": "100%", "height": "100%", "fit": "cover" },
        "shade": { "type": "rect", "color": "#00000040", "color2": "#000000b0" },
      },
    },
    "logo": { "hide": true },
    "bar": { "hide": true },
  },
  "elements": {
    "cake": { "type": "image", "src": "icon_48.png", "pixelated": true, "anchor": "center", "y": -40, "width": 192, "height": 192,
              "transform": { "scale": "1 + 0.04 * sin(time * 4)" } },
    "track": { "type": "rect", "anchor": "center", "y": 140, "width": 640, "height": 10, "color": "#ffffff30", "layer": "front" },
    "bar": { "type": "bar", "anchor": "center", "y": 140, "width": 640, "height": 10, "value": "launch.progress", "color": "accent", "layer": "front" },
  },
}
