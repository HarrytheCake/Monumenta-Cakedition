// Every "please wait" screen: connecting, loading terrain (shard switches), reconfiguring,
// preparing a world, progress and saving. {loading.kind} says which, {loading.progress} is 0…1
// when known (else -1), {loading.text} is vanilla's text.
{
  "$schema": "../../../schema/layout.schema.json",
  "ports": {
    "background": {
      "hide": true,
      "elements": {
        "sky": { "type": "image", "src": "bg.png", "width": "100%", "height": "100%", "fit": "cover" },
        "city": { "type": "image", "src": "far.png", "width": "100%", "height": "100%", "fit": "cover" },
        "shade": { "type": "rect", "color": "#00000060", "color2": "#000000c0" },
      },
    },
    "text": { "color": "accent", "y": 60 },
    "map": { "hide": true },
  },
  "elements": {
    "title": { "type": "text", "text": "{t:example.title}", "anchor": "center", "origin": "bottom", "y": -260, "size": 96, "color": "paper", "shadow": true },
    "spark": { "type": "image", "src": "spark.png", "frames": 8, "fps": 12, "pixelated": true, "anchor": "center", "y": 20, "width": 48, "height": 48,
               "transform": { "rotateZ": "time * 90" } },
    "track": { "type": "rect", "anchor": "center", "y": 110, "width": 600, "height": 8, "color": "#ffffff30", "visible": "= loading.progress >= 0" },
    "bar": { "type": "bar", "anchor": "center", "y": 110, "width": 600, "height": 8, "value": "loading.progress", "color": "accent",
             "visible": "= loading.progress >= 0" },
  },
}
