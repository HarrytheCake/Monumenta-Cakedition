// CakeUI's config map for Item Highlighter (CakeUI ADR 0011), checked against Highlighter-1.20.2-fabric-1.1.9. Only in CakeUI's 1.20.4 jars.
{
  "format": 1,
  "mod": "highlighter",
  "versions": ">=1.1 <1.2",
  "file": "config/highlighter-common.toml",
  "type": "toml",
  "title": "Item Highlighter",
  "options": [
    {
      "key": "client.options.show_on_hotbar",
      "type": "bool",
      "label": "cakeui.map.highlighter.show_on_hotbar",
      "default": true
    },
    {
      "key": "client.options.icon_position",
      "type": "enum",
      "label": "cakeui.map.highlighter.icon_position",
      "default": "UpperLeft",
      "values": [
        {
          "value": "UpperLeft",
          "label": "cakeui.map.highlighter.position.upperleft"
        },
        {
          "value": "UpperRight",
          "label": "cakeui.map.highlighter.position.upperright"
        },
        {
          "value": "LowerLeft",
          "label": "cakeui.map.highlighter.position.lowerleft"
        },
        {
          "value": "LowerRight",
          "label": "cakeui.map.highlighter.position.lowerright"
        }
      ]
    },
    {
      "key": "client.options.item_name_color",
      "type": "bool",
      "label": "cakeui.map.highlighter.item_name_color",
      "default": false
    },
    {
      "key": "client.options.clear_on_close",
      "type": "bool",
      "label": "cakeui.map.highlighter.clear_on_close",
      "default": true
    },
    {
      "key": "client.options.clear_on_hover",
      "type": "bool",
      "label": "cakeui.map.highlighter.clear_on_hover",
      "default": true
    },
    {
      "key": "client.options.clear_on_select",
      "type": "bool",
      "label": "cakeui.map.highlighter.clear_on_select",
      "default": true
    }
  ]
}
