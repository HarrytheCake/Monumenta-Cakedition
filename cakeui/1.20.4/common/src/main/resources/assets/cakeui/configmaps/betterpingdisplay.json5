// CakeUI's config map for Better Ping Display (CakeUI ADR 0011), checked against BetterPingDisplay-Fabric-1.20.4-1.1.1. Only in CakeUI's 1.20.4 jars.
{
  "format": 1,
  "mod": "betterpingdisplay",
  "versions": ">=1.1 <1.2",
  "file": "config/betterpingdisplay.json",
  "type": "json",
  "title": "Better Ping Display",
  "options": [
    {
      "key": "autoColorPingText",
      "type": "bool",
      "label": "cakeui.map.betterpingdisplay.autoColorPingText",
      "default": true
    },
    {
      "key": "renderPingBars",
      "type": "bool",
      "label": "cakeui.map.betterpingdisplay.renderPingBars",
      "default": false
    },
    {
      "key": "pingTextColor",
      "type": "colour",
      "label": "cakeui.map.betterpingdisplay.pingTextColor",
      "default": "#A0A0A0"
    },
    {
      "key": "pingTextFormatString",
      "type": "string",
      "label": "cakeui.map.betterpingdisplay.pingTextFormatString",
      "default": "%dms"
    }
  ]
}
